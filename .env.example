# =============================================================================
# KYC Application - Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="KYC Verification System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
SECRET_KEY="your-super-secret-key-change-this-in-production-min-32-chars"
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
WORKERS=4
RELOAD=false

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="kyc_db"
POSTGRES_USER="kyc_user"
POSTGRES_PASSWORD="kyc_password_change_in_prod"
DATABASE_URL="postgresql+asyncpg://kyc_user:kyc_password_change_in_prod@localhost:5432/kyc_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis Settings
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=10
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="your-jwt-secret-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/jpg,application/pdf"

# -----------------------------------------------------------------------------
# AI / LLM Settings
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4-vision-preview"
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_MODEL="gemini-pro-vision"
LLM_PROVIDER="openai"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# OCR Settings
# -----------------------------------------------------------------------------
OCR_LANGUAGE="en"
OCR_GPU=false

# -----------------------------------------------------------------------------
# Celery Settings
# -----------------------------------------------------------------------------
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_TIMEOUT=300

# -----------------------------------------------------------------------------
# Email Settings (for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-email-password"
SMTP_TLS=true
EMAIL_FROM="noreply@kyc-system.com"
EMAIL_FROM_NAME="KYC Verification System"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE="./logs/kyc_app.log"
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# KYC Business Rules
# -----------------------------------------------------------------------------
KYC_AUTO_APPROVE_THRESHOLD=0.95
KYC_AUTO_REJECT_THRESHOLD=0.30
KYC_REVIEW_REQUIRED_THRESHOLD=0.70
KYC_MAX_SUBMISSION_ATTEMPTS=3
KYC_DOCUMENT_EXPIRY_DAYS=365
